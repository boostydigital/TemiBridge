<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="220dp"
    android:viewportWidth="200"
    android:viewportHeight="220">

    <!-- Water glass with animated waves and bubbles -->
    <group
        android:name="glass_group"
        android:pivotX="100"
        android:pivotY="110">

        <!-- Glass body -->
        <path
            android:name="glass_body"
            android:pathData="M 40 40 L 30 200 Q 100 210 170 200 L 160 40 Z"
            android:strokeColor="#1565a0"
            android:strokeWidth="2"
            android:fillColor="@android:color/transparent"/>

        <!-- Water fill -->
        <path
            android:name="water_fill"
            android:pathData="M 40 120 L 32 200 Q 100 208 168 200 L 160 120 Z"
            android:fillColor="#4fc3f7"
            android:alpha="0.7"/>

        <!-- Water surface wave -->
        <path
            android:name="water_surface"
            android:pathData="M 40 120 Q 70 110 100 120 Q 130 130 160 120"
            android:strokeColor="#1565a0"
            android:strokeWidth="2"
            android:fillColor="@android:color/transparent"
            android:strokeLineCap="round"/>

        <!-- Glass rim -->
        <path
            android:name="glass_rim"
            android:pathData="M 40 40 Q 100 32 160 40"
            android:strokeColor="#1565a0"
            android:strokeWidth="2"
            android:fillColor="@android:color/transparent"
            android:strokeLineCap="round"/>
    </group>

    <!-- Bubbles (animated with rise animation) -->
    <path
        android:name="bubble_1"
        android:pathData="M 60 180 Q 63 180 63 177 Q 63 174 60 174 Q 57 174 57 177 Q 57 180 60 180"
        android:fillColor="#4fc3f7"
        android:alpha="0.5"/>
    <path
        android:name="bubble_2"
        android:pathData="M 100 190 Q 102.5 190 102.5 187.5 Q 102.5 185 100 185 Q 97.5 185 97.5 187.5 Q 97.5 190 100 190"
        android:fillColor="#4fc3f7"
        android:alpha="0.5"/>
    <path
        android:name="bubble_3"
        android:pathData="M 140 185 Q 142 185 142 183 Q 142 181 140 181 Q 138 181 138 183 Q 138 185 140 185"
        android:fillColor="#4fc3f7"
        android:alpha="0.5"/>

</vector>
