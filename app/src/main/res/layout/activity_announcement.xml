<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.AnnouncementActivity">

    <!-- Imagen del anuncio - FULLSCREEN -->
    <ImageView
        android:id="@+id/announcementImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:visibility="gone"
        tools:visibility="visible"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Overlay semitransparente para mejorar legibilidad del texto -->
    <View
        android:id="@+id/textOverlay"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom_overlay" />

    <!-- Texto del anuncio (sobre la imagen, en la parte inferior) -->
    <TextView
        android:id="@+id/announcementText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="80dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="4"
        android:ellipsize="end"
        tools:text="¡Bienvenidos al Workshop de Inteligencia Artificial!" />

    <!-- Indicador de anuncio activo (esquina inferior) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📢"
            android:textSize="20sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/announcementIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anunciando..."
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-light" />

    </LinearLayout>

</FrameLayout>
