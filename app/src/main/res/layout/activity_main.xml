<?xml version="1.0" encoding="utf-8"?>
<!-- Layout simplificado: imagen de fondo + solo frame de escaneo QR -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen de fondo Spatium 10 Aniversario -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/background_qr_scan"
        android:contentDescription="Fondo Spatium 10 Aniversario" />

    <!-- Frame de escaneo QR posicionado en la esquina superior izquierda -->
    <!-- Ajustado para coincidir con la posición del cuadro en la imagen -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="400dp"
        android:layout_height="280dp"
        android:layout_marginStart="298dp"
        android:layout_marginTop="32dp"
        android:layout_gravity="top|start">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Línea de escaneo animada -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@color/gold"
            android:alpha="0.9" />
    </FrameLayout>

    <!-- Elementos ocultos para compatibilidad con código existente -->
    <ImageView
        android:id="@+id/logoSpatium"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mainText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <View
        android:id="@+id/btnFullscreenScanner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/btnTour"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/qrIconCenter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/scanFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/scanStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/btnSeqPlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/btnSeqTest"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/permPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
