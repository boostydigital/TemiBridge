<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="600dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="40dp"
    android:background="@drawable/bg_glass_panel">

    <!-- Icono de producto -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="24dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ivProductIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_rawRes="@raw/tea"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_speed="1.0"/>
    </FrameLayout>

    <!-- Tu Pedido label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu Pedido"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.15"
        android:layout_marginBottom="6dp"/>

    <!-- Nombre del producto -->
    <TextView
        android:id="@+id/tvProductName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Té Verde"
        android:textColor="@color/white"
        android:textSize="42sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="8dp"/>

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opción saludable y antioxidante"
        android:textColor="@color/text_gray_300"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"/>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_btn_cancel"
            android:layout_marginEnd="12dp"/>

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Confirmar y Enviar  →"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            android:background="@drawable/bg_btn_confirm"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

    <!-- btnClose oculto para compatibilidad con código existente -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="Cerrar"/>

</LinearLayout>
