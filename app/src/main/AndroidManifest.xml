<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.spatium.deamon.db.temi"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- Permisos Android estándar -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Permisos del SDK de Temi -->
    <uses-permission android:name="com.robotemi.permission.sequence" />
    <uses-permission android:name="com.robotemi.permission.face_recognition" />
    <uses-permission android:name="com.robotemi.permission.map" />
    <uses-permission android:name="com.robotemi.permission.settings" />
    <uses-permission android:name="com.robotemi.permission.admin" />

    <application
        android:name=".TemiDaemonApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.TemiBridge">

        <!-- Temi SDK metadata -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.SKILL"
            android:value="Deamon DB TEMI" />

        <!-- Declare Temi capabilities so they appear in robot permissions UI -->
        <meta-data
            android:name="@string/metadata_permissions"
            android:value="com.robotemi.permission.sequence,com.robotemi.permission.face_recognition,com.robotemi.permission.map,com.robotemi.permission.settings,com.robotemi.permission.admin" />

        <meta-data
            android:name="com.robotemi.sdk.metadata.KIOSK"
            android:value="TRUE" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TemiBridge">
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:hardwareAccelerated="false"
            android:theme="@style/Theme.TemiBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.IntentEntryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Transparent">
            <!-- Deep links: mytemi://... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mytemi"/>
            </intent-filter>
            

            <!-- Acciones explícitas para Despia -->
            <intent-filter>
                <action android:name="com.spatium.temibridge.ACTION_GO_TO"/>
                <action android:name="com.spatium.temibridge.ACTION_SAY"/>
                <action android:name="com.spatium.temibridge.ACTION_FOLLOW_ME"/>
                <action android:name="com.spatium.temibridge.ACTION_STOP"/>
                <action android:name="com.spatium.temibridge.ACTION_HEAD_TILT"/>
                <action android:name="com.spatium.temibridge.ACTION_VOLUME"/>
                <action android:name="com.spatium.temibridge.ACTION_TOUR_START"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.KioskWebActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".ui.MenuActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.OrderConfirmationActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.OrderSuccessActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.PartyActivity"
            android:exported="false"
            android:hardwareAccelerated="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.MapSelectorActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.PrefixSelectorActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.SelfieHunterActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.RatingActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.FotosActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.CountdownActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.PhotoPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"/>

        <activity
            android:name=".ui.AnnouncementActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <service
            android:name=".core.RobotPedidosForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="robot_pedidos_sync" />
        </service>

        <!-- Servicio de accesibilidad para WhatsApp -->
        <service
            android:name=".ui.WhatsAppAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
