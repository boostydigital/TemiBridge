<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.spatium.temibridge"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.robotemi.sdk.permission.SEQUENCE" />

    <application
        android:label="Temi Bridge"
        android:theme="@style/Theme.TemiBridge">

        <!-- Temi SDK metadata -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.SKILL"
            android:value="Temi Bridge" />

        <!-- Declare Temi capabilities this app requires so they appear in robot permissions UI -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.PERMISSIONS"
            android:value="com.robotemi.permission.sequence" />

        <meta-data
            android:name="com.robotemi.sdk.metadata.KIOSK"
            android:value="TRUE" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TemiBridge">
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TemiBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.IntentEntryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Transparent">
            <!-- Deep links: mytemi://... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mytemi"/>
            </intent-filter>
            <!-- Deep link: mytemi://go?place=Lobby | mytemi://say?text=Hola -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mytemi"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mytemi"/>
            </intent-filter>

            <!-- Acciones explícitas para Despia -->
            <intent-filter>
                <action android:name="com.spatium.temibridge.ACTION_GO_TO"/>
                <action android:name="com.spatium.temibridge.ACTION_SAY"/>
                <action android:name="com.spatium.temibridge.ACTION_FOLLOW_ME"/>
                <action android:name="com.spatium.temibridge.ACTION_STOP"/>
                <action android:name="com.spatium.temibridge.ACTION_HEAD_TILT"/>
                <action android:name="com.spatium.temibridge.ACTION_VOLUME"/>
                <action android:name="com.spatium.temibridge.ACTION_TOUR_START"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.KioskWebActivity"
            android:exported="false"
            android:theme="@style/Theme.TemiBridge"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"/>

    </application>
</manifest>